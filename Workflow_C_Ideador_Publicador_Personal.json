      "id": "07114a0a-0300-49b9-be46-3066377dcf0a",
      "name": "Generar copy personal con Groq",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.4,
      "position": [
        672,
        384
      ],
      "credentials": {
        "groqApi": {
          "id": "YOUR_GROQ_API_CREDENTIAL_ID",
          "name": "groqApi credential"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "const content = String($json.choices?.[0]?.message?.content ?? '').trim();\nconst clean = content.replace(/^```json\\s*/i, '').replace(/```$/i, '').trim();\nconst parsed = JSON.parse(clean);\n\nconst formatForLinkedIn = (value) => {\n  const source = String(value ?? '').replace(/\\r\\n/g, '\\n').trim();\n  if (!source) return '';\n\n  const result = [];\n  const sourceParagraphs = source.split(/\\n\\s*\\n/).map((part) => part.replace(/\\s+/g, ' ').trim()).filter(Boolean);\n\n  for (const paragraph of sourceParagraphs) {\n    if (/^(?:#\\S+\\s*)+$/.test(paragraph)) {\n      result.push(paragraph);\n      continue;\n    }\n\n    const sentences = paragraph.match(/.*?(?:[.!?]+(?=\\s|$)|$)/g)?.map((sentence) => sentence.trim()).filter(Boolean) ?? [paragraph];\n    let group = [];\n\n    const flush = () => {\n      if (group.length) result.push(group.join(' '));\n      group = [];\n    };\n\n    for (const sentence of sentences) {\n      const isQuestion = sentence.startsWith('¿');\n      const nextLength = [...group, sentence].join(' ').length;\n\n      if (isQuestion) {\n        flush();\n        result.push(sentence);\n      } else {\n        if (group.length >= 2 || nextLength > 220) flush();\n        group.push(sentence);\n      }\n    }\n\n    flush();\n  }\n\n  return result.join('\\n\\n').replace(/\\n{3,}/g, '\\n\\n').trim();\n};\n\nreturn [{ json: { copy: formatForLinkedIn(parsed.copy), visual_prompt: parsed.visual_prompt } }];"
      },
      "id": "9484d23f-6bd0-48b2-a4bc-9dca10c8d7f3",
